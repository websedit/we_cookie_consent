########################################
### websedit/we-cookie-consent (Set) ###
########################################

# Base TypoScript of the extension
@import 'EXT:we_cookie_consent/Configuration/TypoScript/setup.typoscript'

# Notes:
# - We intentionally do NOT map Site Settings into Extbase settings via TypoScript stdWrap (.data = site:settings:...).
#   Extbase does not evaluate stdWrap for settings arrays and would otherwise deliver arrays instead of scalar values.
# - Site Settings are applied in PHP (ConsentController) in a TYPO3 12/13 compatible way.

# Master toggle (if you want to keep the Set active but disable output on a specific site)
[site("settings").get("websedit.we_cookie_consent.enabled") == 0]
page.525304800 >
page.includeCSS.we_cookie_consent_style >
page.includeJSFooter.we_cookie_consent_controller >
page.includeJSFooter.we_cookie_consent_hovercookie >
[END]

# Storage PID can safely be taken from Site Settings because it is NOT part of Extbase "settings".
plugin.tx_wecookieconsent_pi1.persistence.storagePid = {$websedit.we_cookie_consent.storagePid}
plugin.tx_wecookieconsent_pi1.persistence.storagePid.if.isTrue = {$websedit.we_cookie_consent.storagePid}